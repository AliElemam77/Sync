// datasource and client configuration
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// USER & AUTHENTICATION (PHASE 01)
// -----------------------------------------------------------------------------

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique @db.VarChar(255)
  passwordHash    String           @map("password_hash") @db.VarChar(255)
  isActive        Boolean          @default(true) @map("is_active")
  
  // RBAC relation
  roleId          String           @map("role_id") @db.Uuid
  role            Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // 1:1 Link to HR Profile
  employeeProfile          EmployeeProfile?

  // Audit trail relation
  auditLogs                AuditLog[]

  // Chat & Groups relations (PHASE 06)
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]                 @relation("SentMessages")
  messageReadReceipts      MessageReadReceipt[]

  // Accounting & Finance relations (PHASE 10)
  recordedTransactions     FinancialTransaction[]    @relation("RecordedTransactions")
  reversedTransactions     FinancialTransaction[]    @relation("ReversedTransactions")

  // Payroll approval relations (PHASE 06)
  approvedPayrollCycles    PayrollCycle[]            @relation("ApprovedPayrollCycles")

  // Bonuses granted or cancelled by this user
  grantedBonuses           Bonus[]                   @relation("GrantedBonuses")
  cancelledBonuses         Bonus[]                   @relation("CancelledBonuses")

  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([email])
  @@index([roleId])
  @@map("users")
}

// -----------------------------------------------------------------------------
// ROLE-BASED ACCESS CONTROL (RBAC) (PHASE 01)
// -----------------------------------------------------------------------------

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique @db.VarChar(50)
  description     String?          @db.VarChar(255)
  isSystem        Boolean          @default(false) @map("is_system")
  
  users           User[]
  rolePermissions RolePermission[]

  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique @db.VarChar(100)
  module          String           @db.VarChar(50)
  description     String?          @db.VarChar(255)
  
  rolePermissions RolePermission[]

  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// -----------------------------------------------------------------------------
// AUDIT LOGGING (PHASE 01)
// -----------------------------------------------------------------------------

enum AuditAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  CREATE
  UPDATE
  DELETE
  EXPORT
}

model AuditLog {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String?      @map("user_id") @db.Uuid
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action    AuditAction
  entity    String       @db.VarChar(100)
  entityId  String?      @map("entity_id") @db.VarChar(255)
  metadata  Json?        @db.JsonB
  ipAddress String?      @map("ip_address") @db.VarChar(45)
  userAgent String?      @map("user_agent") @db.Text

  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([entity, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// ORGANIZATION STRUCTURE (PHASE 02)
// -----------------------------------------------------------------------------

model Department {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(100)
  code        String            @unique @db.VarChar(20)
  description String?           @db.VarChar(255)
  isActive    Boolean           @default(true) @map("is_active")

  // Department Head (PHASE 11: Multi-Department Heads)
  headId      String?           @map("head_id") @db.Uuid
  head        EmployeeProfile?  @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)

  // Commission earned per accepted task (x task weight) by employees of this department; set by Management
  commissionPerTask Decimal     @default(0) @map("commission_per_task") @db.Decimal(12, 2)

  positions   Position[]
  employees   EmployeeProfile[]

  // Cross-Department task routing (PHASE 04)
  targetTasks   Task[]            @relation("DepartmentTargetTasks")

  // Chat channels (PHASE 06)
  conversations Conversation[]

  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([code])
  @@index([headId])
  @@map("departments")
}

model Position {
  id           String            @id @default(uuid()) @db.Uuid
  name         String            @db.VarChar(100)
  description  String?           @db.VarChar(255)
  isActive     Boolean           @default(true) @map("is_active")

  departmentId String            @map("department_id") @db.Uuid
  department   Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  levels       Level[]
  employees    EmployeeProfile[]

  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([departmentId, name])
  @@index([departmentId])
  @@map("positions")
}

model Level {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(50)
  rank        Int               @default(1)
  description String?           @db.VarChar(255)

  positionId  String            @map("position_id") @db.Uuid
  position    Position          @relation(fields: [positionId], references: [id], onDelete: Restrict)

  employees   EmployeeProfile[]

  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([positionId, name])
  @@index([positionId])
  @@map("levels")
}

// -----------------------------------------------------------------------------
// EMPLOYEES MODULE (PHASE 03)
// -----------------------------------------------------------------------------

enum ShiftType {
  RS // Regular Shift (6 days, 8 hrs/day)
  LS // Long Shift (5 days, 9 hrs/day)
}

enum Gender {
  MALE
  FEMALE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  TRAINING
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  PROBATION
  ENDED
}

enum EmergencyRelationship {
  FATHER
  MOTHER
  BROTHER
  SISTER
  SPOUSE
  OTHER
}

enum DocumentType {
  NATIONAL_ID
  PASSPORT
  CV
  CONTRACT
  OTHER
}

model EmployeeProfile {
  id                     String            @id @default(uuid()) @db.Uuid
  userId                 String            @unique @map("user_id") @db.Uuid
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Basic Info
  employeeCode           String            @unique @map("employee_code") @db.VarChar(20)
  fullName               String            @map("full_name") @db.VarChar(150)
  phone                  String            @db.VarChar(30)
  dob                    DateTime?         @db.Date
  gender                 Gender            @default(MALE)
  avatarUrl              String?           @map("avatar_url") @db.Text

  // Shift & Default Entitlements
  shiftType              ShiftType         @default(RS) @map("shift_type")
  // Monthly permission allowance (what is left is computed per month)
  monthlyPermissionHours Int               @default(4) @map("monthly_permission_hours")
  // Annual leave balance: accrues 21/12 days every month and carries over between years
  annualLeaveDays        Decimal           @default(0) @map("annual_leave_days") @db.Decimal(6, 2)
  // First day of the last month whose accrual has been credited
  leaveAccruedThrough    DateTime?         @map("leave_accrued_through") @db.Date

  // Employment Details
  company                String            @default("Tawfeer") @db.VarChar(100)
  branch                 String            @default("Headquarters") @db.VarChar(100)
  departmentId           String            @map("department_id") @db.Uuid
  department             Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  positionId             String            @map("position_id") @db.Uuid
  position               Position          @relation(fields: [positionId], references: [id], onDelete: Restrict)
  levelId                String?           @map("level_id") @db.Uuid
  level                  Level?            @relation(fields: [levelId], references: [id], onDelete: SetNull)

  joiningDate            DateTime          @default(now()) @map("joining_date") @db.Date
  employmentType         EmploymentType    @default(FULL_TIME) @map("employment_type")
  status                 EmployeeStatus    @default(ACTIVE)

  // Contact Info
  address                String?           @db.Text
  altPhone               String?           @map("alt_phone") @db.VarChar(30)

  // 1:1 Sub-aggregates
  emergencyContact       EmergencyContact?
  bankInfo               BankInfo?
  documents              EmployeeDocument[]

  // Task relations (PHASE 04)
  createdTasks           Task[]            @relation("CreatedTasks")
  assignedTasks          Task[]            @relation("AssignedTasks")
  taskComments           TaskComment[]

  // Attendance & Requests relations (PHASE 05)
  attendanceRecords        AttendanceRecord[]
  leaveRequests            LeaveRequest[]
  permissionRequests       PermissionRequest[]

  // Chat & Groups relations (PHASE 06)
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]                 @relation("SentEmployeeMessages")

  // IT Asset Management relations (PHASE 09)
  assignedAssets           Asset[]                   @relation("EmployeeAssignedAssets")
  assetAssignments         AssetAssignmentHistory[]  @relation("EmployeeAssetAssignments")
  performedAssetActions    AssetAssignmentHistory[]  @relation("ActorAssetAssignments")

  // Multi-Department Head oversight (PHASE 11)
  managedDepartments       Department[]              @relation("DepartmentHead")

  // Payroll & Compensation relations (PHASE 06)
  salaryProfile            SalaryProfile?
  payslips                 Payslip[]
  bonuses                  Bonus[]

  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([employeeCode])
  @@index([departmentId])
  @@index([positionId])
  @@index([status])
  @@map("employee_profiles")
}

model EmergencyContact {
  id                String                @id @default(uuid()) @db.Uuid
  employeeProfileId String                @unique @map("employee_profile_id") @db.Uuid
  employeeProfile   EmployeeProfile       @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  name              String                @db.VarChar(100)
  relationship      EmergencyRelationship @default(OTHER)
  phone             String                @db.VarChar(30)

  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("emergency_contacts")
}

model BankInfo {
  id                String          @id @default(uuid()) @db.Uuid
  employeeProfileId String          @unique @map("employee_profile_id") @db.Uuid
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  bankName          String?         @map("bank_name") @db.VarChar(100)
  accountHolder     String?         @map("account_holder") @db.VarChar(150)
  accountNumber     String?         @map("account_number") @db.VarChar(50)
  iban              String?         @db.VarChar(50)
  swift             String?         @db.VarChar(30)
  branch            String?         @db.VarChar(100)
  basicSalary       Decimal         @default(0.0) @map("basic_salary") @db.Decimal(12, 2)

  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("bank_infos")
}

model EmployeeDocument {
  id                String          @id @default(uuid()) @db.Uuid
  employeeProfileId String          @map("employee_profile_id") @db.Uuid
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  type              DocumentType    @default(NATIONAL_ID)
  fileName          String          @map("file_name") @db.VarChar(255)
  fileUrl           String          @map("file_url") @db.Text

  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([employeeProfileId])
  @@map("employee_documents")
}

// -----------------------------------------------------------------------------
// TASKS & WORKFLOW MANAGEMENT (PHASE 04)
// -----------------------------------------------------------------------------

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  WAITING_FOR_CLIENT
  NEEDS_REVISION
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskAssignmentType {
  DEPARTMENT
  SELF_OR_TEAM
}

model Task {
  id                 String              @id @default(uuid()) @db.Uuid
  title              String              @db.VarChar(255)
  description        String?             @db.Text
  status             TaskStatus          @default(TODO)
  priority           TaskPriority        @default(MEDIUM)
  assignmentType     TaskAssignmentType  @default(SELF_OR_TEAM) @map("assignment_type")
  dueDate            DateTime?           @map("due_date") @db.Timestamptz(6)
  order              Int                 @default(0)

  // Effort weight set by the Team Leader / head (1 = normal task, 2 = heavy task); multiplies commission
  weight             Decimal             @default(1) @db.Decimal(3, 1)
  // When the requester accepted the task (status DONE); commission is earned in this month
  completedAt        DateTime?           @map("completed_at") @db.Timestamptz(6)

  // Requester / Creator (EmployeeProfile)
  creatorId          String              @map("creator_id") @db.Uuid
  creator            EmployeeProfile     @relation("CreatedTasks", fields: [creatorId], references: [id], onDelete: Restrict)

  // Cross-Department Target (Optional for Department Routing)
  targetDepartmentId String?             @map("target_department_id") @db.Uuid
  targetDepartment   Department?         @relation("DepartmentTargetTasks", fields: [targetDepartmentId], references: [id], onDelete: SetNull)

  // Direct Assignee (Optional when routed to department backlog)
  assigneeId         String?             @map("assignee_id") @db.Uuid
  assignee           EmployeeProfile?    @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Comments & Rejection Feedback History
  comments           TaskComment[]

  // ImgBB Image Attachments
  attachmentUrls     String[]            @default([]) @map("attachment_urls")

  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([creatorId])
  @@index([targetDepartmentId])
  @@index([assigneeId])
  @@index([dueDate])
  @@map("tasks")
}

model TaskComment {
  id             String          @id @default(uuid()) @db.Uuid
  taskId         String          @map("task_id") @db.Uuid
  task           Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  authorId       String          @map("author_id") @db.Uuid
  author         EmployeeProfile @relation(fields: [authorId], references: [id], onDelete: Restrict)
  
  content        String          @db.Text
  attachmentUrls String[]        @default([]) @map("attachment_urls")

  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([taskId])
  @@index([authorId])
  @@map("task_comments")
}

// =============================================================================
// PHASE 05: ATTENDANCE, LEAVES & PERMISSIONS ENUMS & MODELS
// =============================================================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HOLIDAY
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MATERNITY
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// -----------------------------------------------------------------------------
// ATTENDANCE RECORD
// -----------------------------------------------------------------------------

model AttendanceRecord {
  id              String           @id @default(uuid()) @db.Uuid
  employeeId      String           @map("employee_id") @db.Uuid
  employee        EmployeeProfile  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date            DateTime         @db.Date
  checkInTime     DateTime         @map("check_in_time") @db.Timestamptz(6)
  checkOutTime    DateTime?        @map("check_out_time") @db.Timestamptz(6)
  status          AttendanceStatus @default(PRESENT)

  delayMinutes    Int              @default(0) @map("delay_minutes")
  overtimeMinutes Int              @default(0) @map("overtime_minutes")

  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@map("attendance_records")
}

// -----------------------------------------------------------------------------
// LEAVE REQUEST (الإجازات)
// -----------------------------------------------------------------------------

model LeaveRequest {
  id                 String           @id @default(uuid()) @db.Uuid
  employeeId         String           @map("employee_id") @db.Uuid
  employee           EmployeeProfile  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  startDate          DateTime         @map("start_date") @db.Date
  endDate            DateTime         @map("end_date") @db.Date
  totalDaysRequested Int              @map("total_days_requested")
  type               LeaveType        @default(ANNUAL)
  status             RequestStatus    @default(PENDING)

  reason             String?          @db.Text
  rejectionReason    String?          @map("rejection_reason") @db.Text

  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

// -----------------------------------------------------------------------------
// PERMISSION REQUEST (الأذونات)
// -----------------------------------------------------------------------------

model PermissionRequest {
  id              String           @id @default(uuid()) @db.Uuid
  employeeId      String           @map("employee_id") @db.Uuid
  employee        EmployeeProfile  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date            DateTime         @db.Date
  startTime       String?          @map("start_time") @db.VarChar(10)
  endTime         String?          @map("end_time") @db.VarChar(10)
  hoursRequested  Int              @map("hours_requested")
  status          RequestStatus    @default(PENDING)

  reason          String           @db.Text
  rejectionReason String?          @map("rejection_reason") @db.Text

  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([employeeId])
  @@index([status])
  @@index([date])
  @@map("permission_requests")
}

// -----------------------------------------------------------------------------
// PUBLIC HOLIDAY (الإجازات الرسمية)
// -----------------------------------------------------------------------------

// Company-wide days off (feasts, national holidays): never counted as absence
model PublicHoliday {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @unique @db.Date
  name      String   @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("public_holidays")
}

// =============================================================================
// PHASE 06: REAL-TIME CHAT & GROUPS MODULE ENUMS & MODELS
// =============================================================================

enum ConversationType {
  DIRECT
  WORK_GROUP
  PUBLIC_GROUP
}

enum ParticipantRole {
  MEMBER
  ADMIN
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

// -----------------------------------------------------------------------------
// CONVERSATION (المحادثات والمجموعات)
// -----------------------------------------------------------------------------

model Conversation {
  id             String                   @id @default(uuid()) @db.Uuid
  title          String?                  @db.VarChar(150)
  description    String?                  @db.Text
  avatarUrl      String?                  @map("avatar_url") @db.Text
  type           ConversationType         @default(DIRECT)
  isGroup        Boolean                  @default(false) @map("is_group")

  // Optional link to Department (e.g. for department work groups)
  departmentId   String?                  @map("department_id") @db.Uuid
  department     Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // Creator / Owner user ID
  creatorId      String?                  @map("creator_id") @db.Uuid

  // Relational Participants & Messages
  participants   ConversationParticipant[]
  messages       Message[]

  lastMessageAt  DateTime?                @map("last_message_at") @db.Timestamptz(6)

  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([type])
  @@index([departmentId])
  @@index([lastMessageAt])
  @@map("conversations")
}

// -----------------------------------------------------------------------------
// CONVERSATION PARTICIPANT (المشاركون في المحادثة)
// -----------------------------------------------------------------------------

model ConversationParticipant {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId         String           @map("user_id") @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeId     String?          @map("employee_id") @db.Uuid
  employee       EmployeeProfile? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  role           ParticipantRole  @default(MEMBER)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  lastReadAt     DateTime?        @map("last_read_at") @db.Timestamptz(6)
  isMuted        Boolean          @default(false) @map("is_muted")

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([employeeId])
  @@index([conversationId])
  @@map("conversation_participants")
}

// -----------------------------------------------------------------------------
// MESSAGE (الرسائل)
// -----------------------------------------------------------------------------

model Message {
  id               String               @id @default(uuid()) @db.Uuid
  conversationId   String               @map("conversation_id") @db.Uuid
  conversation     Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId         String               @map("sender_id") @db.Uuid
  sender           User                 @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  senderEmployeeId String?              @map("sender_employee_id") @db.Uuid
  senderEmployee   EmployeeProfile?     @relation("SentEmployeeMessages", fields: [senderEmployeeId], references: [id], onDelete: SetNull)

  // Reply Reference (الرد على رسالة)
  replyToId        String?              @map("reply_to_id") @db.Uuid
  replyTo          Message?             @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies          Message[]            @relation("MessageReplies")

  content          String               @db.Text
  type             MessageType          @default(TEXT)
  attachmentUrls   String[]             @default([]) @map("attachment_urls")

  // Reactions JSON array: [{ emoji: "👍", userId: "...", userName: "..." }]
  reactions        Json?                @default("[]")

  isEdited         Boolean              @default(false) @map("is_edited")
  isDeleted        Boolean              @default(false) @map("is_deleted")

  readReceipts     MessageReadReceipt[]

  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@map("messages")
}

// -----------------------------------------------------------------------------
// MESSAGE READ RECEIPT (إشعارات القراءة)
// -----------------------------------------------------------------------------

model MessageReadReceipt {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt    DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("message_read_receipts")
}

// -----------------------------------------------------------------------------
// IT ASSET MANAGEMENT MODULE (PHASE 09)
// -----------------------------------------------------------------------------

enum AssetType {
  HARDWARE
  SOFTWARE
  FURNITURE
  OTHER
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_MAINTENANCE
  RETIRED
}

model Asset {
  id                 String                   @id @default(uuid()) @db.Uuid
  name               String                   @db.VarChar(150)
  serialNumber       String                   @unique @map("serial_number") @db.VarChar(100)
  type               AssetType                @default(HARDWARE)
  status             AssetStatus              @default(AVAILABLE)

  model              String?                  @db.VarChar(100)
  manufacturer       String?                  @db.VarChar(100)
  purchaseDate       DateTime?                @map("purchase_date") @db.Date
  purchaseCost       Decimal?                 @map("purchase_cost") @db.Decimal(12, 2)
  warrantyExpiry     DateTime?                @map("warranty_expiry") @db.Date
  notes              String?                  @db.Text
  imageUrl           String?                  @map("image_url") @db.Text

  // Current Assignee (عهدة حالية لموظف)
  assigneeId         String?                  @map("assignee_id") @db.Uuid
  assignee           EmployeeProfile?         @relation("EmployeeAssignedAssets", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Full Assignment & Movement History (سجل حركات العهدة)
  assignmentHistory  AssetAssignmentHistory[]

  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([serialNumber])
  @@index([type])
  @@index([status])
  @@index([assigneeId])
  @@map("assets")
}

model AssetAssignmentHistory {
  id             String           @id @default(uuid()) @db.Uuid
  assetId        String           @map("asset_id") @db.Uuid
  asset          Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)

  employeeId     String           @map("employee_id") @db.Uuid
  employee       EmployeeProfile  @relation("EmployeeAssetAssignments", fields: [employeeId], references: [id], onDelete: Cascade)

  assignedAt     DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(6)
  returnedAt     DateTime?        @map("returned_at") @db.Timestamptz(6)
  conditionNotes String?          @map("condition_notes") @db.Text

  // Performed By (المسؤول أو المدير الذي قام بالتسليم/الاستلام)
  assignedById   String?          @map("assigned_by_id") @db.Uuid
  assignedBy     EmployeeProfile? @relation("ActorAssetAssignments", fields: [assignedById], references: [id], onDelete: SetNull)

  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([assetId])
  @@index([employeeId])
  @@index([assignedAt])
  @@index([returnedAt])
  @@map("asset_assignment_history")
}

// -----------------------------------------------------------------------------
// ACCOUNTING & FINANCE MODULE (PHASE 10)
// -----------------------------------------------------------------------------

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  PAYROLL
  ASSET_PURCHASE
  SUBSCRIPTION
  CLIENT_PAYMENT
  OPERATIONAL_EXPENSE
  TAX_AND_GOVERNMENT
  INVESTMENT
  MISC
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CREDIT_CARD
  CHEQUE
  ONLINE_GATEWAY
  OTHER
}

model FinancialTransaction {
  id              String              @id @default(uuid()) @db.Uuid
  transactionDate DateTime            @default(now()) @map("transaction_date") @db.Timestamptz(6)
  amount          Decimal             @db.Decimal(14, 2)
  type            TransactionType
  category        TransactionCategory
  paymentMethod   PaymentMethod       @default(BANK_TRANSFER) @map("payment_method")
  description     String              @db.VarChar(255)

  // Reference for cross-module reconciliation (e.g. Asset UUID, Payroll record, Invoice ID)
  referenceId     String?             @map("reference_id") @db.VarChar(100)
  referenceType   String?             @map("reference_type") @db.VarChar(50)
  
  // Attachments (Receipt, tax invoice, bank slip)
  attachmentUrl   String?             @map("attachment_url") @db.Text

  // Immutability & Reversal Audit (Strict Accounting Standard)
  isReversed      Boolean             @default(false) @map("is_reversed")
  reversedAt      DateTime?           @map("reversed_at") @db.Timestamptz(6)
  reversalReason  String?             @map("reversal_reason") @db.Text
  reversedById    String?             @map("reversed_by_id") @db.Uuid
  reversedBy      User?               @relation("ReversedTransactions", fields: [reversedById], references: [id], onDelete: SetNull)

  // Audit trail: Who booked this entry
  recordedById    String              @map("recorded_by_id") @db.Uuid
  recordedBy      User                @relation("RecordedTransactions", fields: [recordedById], references: [id], onDelete: Restrict)

  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([transactionDate])
  @@index([type])
  @@index([category])
  @@index([recordedById])
  @@index([referenceId])
  @@index([isReversed])
  @@map("financial_transactions")
}

// -----------------------------------------------------------------------------
// PAYROLL & COMPENSATION ENGINE (PHASE 06)
// -----------------------------------------------------------------------------

enum PayrollCycleStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
}

enum AdjustmentType {
  BONUS
  PENALTY
  OVERTIME
  COMMISSION
  // A weekly day off that was worked (Saturday for LS), paid as a normal day
  EXTRA_DAY
}

model SalaryProfile {
  id                 String          @id @default(uuid()) @db.Uuid
  employeeId         String          @unique @map("employee_id") @db.Uuid
  employee           EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  baseSalary         Decimal         @default(0.0) @map("base_salary") @db.Decimal(12, 2)
  // How the salary is paid out (CASH or BANK_TRANSFER); bank details are only needed for transfers
  paymentMethod      PaymentMethod   @default(BANK_TRANSFER) @map("payment_method")
  // Unused: allowances and tax are not part of payroll (business decision); kept until dropped
  housingAllowance   Decimal         @default(0.0) @map("housing_allowance") @db.Decimal(12, 2)
  transportAllowance Decimal         @default(0.0) @map("transport_allowance") @db.Decimal(12, 2)
  taxRate            Decimal         @default(0.0) @map("tax_rate") @db.Decimal(5, 2)

  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("salary_profiles")
}

model PayrollCycle {
  id              String             @id @default(uuid()) @db.Uuid
  month           Int
  year            Int
  status          PayrollCycleStatus @default(DRAFT)

  totalGross      Decimal            @default(0.0) @map("total_gross") @db.Decimal(14, 2)
  totalNet        Decimal            @default(0.0) @map("total_net") @db.Decimal(14, 2)

  approvedAt      DateTime?          @map("approved_at") @db.Timestamptz(6)
  approvedById    String?            @map("approved_by_id") @db.Uuid
  approvedBy      User?              @relation("ApprovedPayrollCycles", fields: [approvedById], references: [id], onDelete: SetNull)

  paidAt          DateTime?          @map("paid_at") @db.Timestamptz(6)

  payslips        Payslip[]

  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([year, month])
  @@index([status])
  @@index([year, month])
  @@map("payroll_cycles")
}

model Payslip {
  id                  String                @id @default(uuid()) @db.Uuid
  employeeId          String                @map("employee_id") @db.Uuid
  employee            EmployeeProfile       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payrollCycleId      String                @map("payroll_cycle_id") @db.Uuid
  payrollCycle        PayrollCycle          @relation(fields: [payrollCycleId], references: [id], onDelete: Cascade)

  baseSalary          Decimal               @map("base_salary") @db.Decimal(12, 2)
  grossPay            Decimal               @map("gross_pay") @db.Decimal(12, 2)
  netPay              Decimal               @map("net_pay") @db.Decimal(12, 2)
  totalAllowances     Decimal               @default(0.0) @map("total_allowances") @db.Decimal(12, 2)
  totalDeductions     Decimal               @default(0.0) @map("total_deductions") @db.Decimal(12, 2)
  attendancePenalties Decimal               @default(0.0) @map("attendance_penalties") @db.Decimal(12, 2)

  adjustments         FinancialAdjustment[]

  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([employeeId, payrollCycleId])
  @@index([employeeId])
  @@index([payrollCycleId])
  @@map("payslips")
}

model FinancialAdjustment {
  id          String         @id @default(uuid()) @db.Uuid
  payslipId   String         @map("payslip_id") @db.Uuid
  payslip     Payslip        @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  type        AdjustmentType
  amount      Decimal        @db.Decimal(12, 2)
  reason      String         @db.VarChar(255)
  date        DateTime?      @db.Date

  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([payslipId])
  @@index([type])
  @@map("financial_adjustments")
}



// -----------------------------------------------------------------------------
// COMPANY SETTINGS: a single row (id = 1) of payroll options set by Management
// -----------------------------------------------------------------------------

model CompanySettings {
  id                 Int      @id @default(1)

  // Overtime is paid only after Management turns it on
  overtimeEnabled    Boolean  @default(false) @map("overtime_enabled")
  // Regular hours paid for each overtime hour (2 = an overtime hour pays two regular hours)
  overtimeMultiplier Decimal  @default(2) @map("overtime_multiplier") @db.Decimal(4, 2)

  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("company_settings")
}

// -----------------------------------------------------------------------------
// BONUS (البونص): incentive measured in days, granted by department leaders or Management
// -----------------------------------------------------------------------------

enum BonusKind {
  // Days of pay (salary / 30 each) added to the month's payslip
  PAY
  // Leave days added to the annual leave balance, beyond the yearly 21 (Management only)
  LEAVE
}

model Bonus {
  id            String          @id @default(uuid()) @db.Uuid
  employeeId    String          @map("employee_id") @db.Uuid
  employee      EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  kind          BonusKind       @default(PAY)
  days          Decimal         @db.Decimal(4, 1)
  reason        String          @db.VarChar(200)
  // First day of the payroll month a pay bonus is paid in
  payrollMonth  DateTime        @map("payroll_month") @db.Date

  grantedById   String          @map("granted_by_id") @db.Uuid
  grantedBy     User            @relation("GrantedBonuses", fields: [grantedById], references: [id], onDelete: Restrict)
  cancelledAt   DateTime?       @map("cancelled_at") @db.Timestamptz(6)
  cancelledById String?         @map("cancelled_by_id") @db.Uuid
  cancelledBy   User?           @relation("CancelledBonuses", fields: [cancelledById], references: [id], onDelete: SetNull)

  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([employeeId])
  @@index([payrollMonth])
  @@map("bonuses")
}
