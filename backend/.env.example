# Environment variables for Sync Backend
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sync_erp?schema=public"
# Direct (non-pooled) connection used by Prisma migrations; same as DATABASE_URL when not using a pooler
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/sync_erp?schema=public"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
JWT_EXPIRES_IN="1d"
PORT=4000
# Allowed browser origins for REST and WebSockets (comma-separated for multiple)
CORS_ORIGIN="http://localhost:3000"

# Seed credentials (required by `npm run prisma:seed`; choose your own strong values)
ADMIN_EMAIL="admin@sync-erp.local"
ADMIN_PASSWORD="change-me"
SEED_EMPLOYEE_PASSWORD="change-me"
